# AI Browser Agent - Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# ============================================
# ANTHROPIC AI
# ============================================
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ============================================
# DEFAULT WEBSITE (Optional)
# ============================================
WEBSITE_URL=

# ============================================
# CREDENTIALS (Optional - for auto-login)
# Only used if user explicitly enables auto-login
# ============================================
LOGIN_USERNAME=
LOGIN_EMAIL=
LOGIN_PASSWORD=

# ============================================
# APPLICATION SETTINGS (Optional)
# ============================================
# Headless browser mode (true/false)
HEADLESS_MODE=false

# Default Claude model
CLAUDE_MODEL=claude-opus-4-8

# Automation speed in ms between actions
AUTOMATION_SPEED_MS=500

# Default export directory
EXPORT_DIR=./exports
