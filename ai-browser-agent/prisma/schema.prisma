generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Session {
  id          String   @id @default(uuid())
  name        String
  url         String
  status      String   @default("idle") // idle | active | paused | completed | error
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tasks       Task[]
  history     History[]
  bookmarks   Bookmark[]
}

model Task {
  id           String    @id @default(uuid())
  sessionId    String
  session      Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  instruction  String
  status       String    @default("pending") // pending | running | paused | completed | failed
  actions      String    @default("[]") // JSON array of BrowserAction
  result       String?
  error        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  sources      Source[]
  summaries    Summary[]
  flashcards   Flashcard[]
  quizItems    QuizItem[]
  exports      Export[]
}

model Source {
  id          String   @id @default(uuid())
  taskId      String
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  url         String
  title       String?
  content     String
  extractedAt DateTime @default(now())
  sections    Section[]
}

model Section {
  id        String   @id @default(uuid())
  sourceId  String
  source    Source   @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  title     String?
  content   String
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model Summary {
  id        String   @id @default(uuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  type      String   // simple | detailed | key_concepts | glossary | interview_questions | revision_notes
  content   String
  createdAt DateTime @default(now())
}

model Flashcard {
  id        String   @id @default(uuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  front     String
  back      String
  tags      String   @default("[]") // JSON array
  createdAt DateTime @default(now())
}

model QuizItem {
  id            String   @id @default(uuid())
  taskId        String
  task          Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  question      String
  options       String   @default("[]") // JSON array of strings
  correctAnswer Int      @default(0)
  explanation   String?
  createdAt     DateTime @default(now())
}

model Bookmark {
  id          String   @id @default(uuid())
  sessionId   String?
  session     Session? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  url         String
  title       String
  description String?
  tags        String   @default("[]") // JSON array
  createdAt   DateTime @default(now())
}

model Export {
  id        String   @id @default(uuid())
  taskId    String?
  task      Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  format    String   // markdown | pdf | json
  filename  String
  filepath  String
  size      Int      @default(0)
  createdAt DateTime @default(now())
}

model History {
  id        String   @id @default(uuid())
  sessionId String?
  session   Session? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  url       String
  title     String?
  visitedAt DateTime @default(now())
}

model Settings {
  id              String   @id @default("default")
  theme           String   @default("dark") // light | dark | system
  claudeModel     String   @default("claude-opus-4-8")
  automationSpeed Int      @default(500)
  ocrEnabled      Boolean  @default(false)
  headlessMode    Boolean  @default(false)
  defaultExport   String   @default("markdown")
  approvalMode    String   @default("semi") // manual | semi | auto
  studyMode       Boolean  @default(false)
  exportDir       String   @default("./exports")
  updatedAt       DateTime @updatedAt
}

model TaskTemplate {
  id          String   @id @default(uuid())
  name        String
  description String?
  steps       String   // JSON array of template steps
  plugin      String?  // plugin name if applicable
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
